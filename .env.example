# Sentinel Foundry - Environment Configuration
# Copy to .env and fill in values

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
SECRET_KEY=change-me-in-production-min-32-chars

# Database
DATABASE_URL=sqlite:///./data/sentinel.db

# Keycloak / OIDC
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=sentinel
KEYCLOAK_CLIENT_ID=sentinel-frontend
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_ISSUER_URL=http://localhost:8080/realms/sentinel
OIDC_REDIRECT_URI=http://localhost:5173/callback
OIDC_LOGOUT_REDIRECT_URI=http://localhost:5173

# LLM Providers (optional - configure via UI)
# OpenAI-compatible (OpenRouter, LiteLLM, Ollama, etc.)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=sentinel
VITE_KEYCLOAK_CLIENT_ID=sentinel-frontend